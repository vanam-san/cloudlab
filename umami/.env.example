# Umami deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.

# Umami Docker image
UMAMI_IMAGE=docker.umami.is/umami-software/umami:latest

# Host port exposed for Umami (put Caddy/nginx in front for HTTPS)
UMAMI_PORT=3000

# Postgres database
POSTGRES_USER=umami
POSTGRES_PASSWORD=umami
POSTGRES_DB=umami

# Random string securing auth tokens. Generate with: openssl rand -hex 32
APP_SECRET=change-me