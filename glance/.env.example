# Glance deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.
# NOTE: config/glance.yml (the dashboard itself) IS committed on purpose.

# Glance Docker image (docker pull glanceapp/glance)
GLANCE_IMAGE=glanceapp/glance:latest

# Host port exposed for the dashboard (localhost-only)
GLANCE_PORT=8080