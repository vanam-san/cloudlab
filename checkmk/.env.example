# Checkmk deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.

# Checkmk Raw image (pin a release line; update.sh pulls whatever is set here).
# Tags: https://hub.docker.com/r/checkmk/check-mk-raw/tags
CHECKMK_IMAGE=checkmk/check-mk-raw:2.4.0-latest

# Host port exposed for the web UI (localhost-only).
# 8072 because 3000/3001/8080/8090/9080 are taken by other stacks here.
CHECKMK_PORT=8072

# Site id (default cmk). Only meaningful before first init — changing it
# later abandons the existing site. If you change it, also change the
# tmpfs path in compose.yml to /opt/omd/sites/<id>/tmp.
CMK_SITE_ID=cmk

# Password for the `cmkadmin` login, set at site creation (run.sh offers
# to randomize this on first start if left as change-me). Changing it in
# .env later does NOT change the login — do that in the UI instead
# (Setup > Users > cmkadmin).
CMK_PASSWORD=change-me

# Timezone for the site (e.g. Europe/Berlin).
TZ=UTC
