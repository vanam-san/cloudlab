# Checkmate deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.

# Checkmate app image (ghcr.io/bluewave-labs/checkmate:latest)
CHECKMATE_IMAGE=ghcr.io/bluewave-labs/checkmate:latest

# Host port exposed for the app (localhost-only).
# 8073 because upstream's 52345 cannot bind on this host (daemon refuses
# it); the container-internal port is always 52345.
CHECKMATE_PORT=8073

# Mongo database name (in DB_CONNECTION_STRING path; created on first boot).
MONGO_DB=uptime_db

# URL users reach the app at — used for CORS and links in notifications.
# Default is the localhost URL; set to the public domain for production
# (e.g. CLIENT_HOST=https://checkmate.example.com) and re-run ./run.sh.
CLIENT_HOST=http://localhost:8073

# Secret signing auth tokens (run.sh offers to randomize this on first
# start if left as change-me). Generate manually with: openssl rand -hex 32
# Rotating it later is safe anytime — it just logs everyone out.
JWT_SECRET=change-me

# Optional extra encryption key (empty = disabled).
ENCRYPTION_KEY=

# Server log level: error, warn, info, debug.
LOG_LEVEL=info
