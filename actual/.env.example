# Actual Budget deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.

# Actual Budget server image (actualbudget/actual-server)
ACTUAL_IMAGE=actualbudget/actual-server:latest

# Host port exposed for the web UI (localhost-only). 5006 is upstream's
# default and is free on this host.
ACTUAL_PORT=5006
