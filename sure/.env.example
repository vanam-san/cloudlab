# Sure deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.

# Sure Docker image (ghcr.io/we-promise/sure:stable)
SURE_IMAGE=ghcr.io/we-promise/sure:stable

# Host port exposed for the web UI (localhost-only).
# 3001 because Umami already uses 3000 on this host.
PORT=3001

# Database (randomized by run.sh on first start if left as change-me)
POSTGRES_USER=sure_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sure_production

# Rails secret (randomized by run.sh on first start if left as change-me).
# Generate manually with: openssl rand -hex 64
SECRET_KEY_BASE=change-me

# Optional: AI features (chat, rules). Incurs OpenAI costs; set spend
# limits on your account before enabling. Leave empty to disable.
OPENAI_ACCESS_TOKEN=
OPENAI_MODEL=
OPENAI_URI_BASE=

# Set to true when serving through Caddy with HTTPS in production, so
# Rails knows the proxied requests were originally HTTPS.
# RAILS_ASSUME_SSL=true