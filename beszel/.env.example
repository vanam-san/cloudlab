# Beszel deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.

# Beszel hub Docker image (docker pull henrygd/beszel)
BESZEL_IMAGE=henrygd/beszel:latest

# Beszel agent Docker image, started only when AGENT_TOKEN/AGENT_KEY below
# are set (docker pull henrygd/beszel-agent)
BESZEL_AGENT_IMAGE=henrygd/beszel-agent:latest

# Host port exposed for the hub (localhost-only)
BESZEL_PORT=8090

# URL used to reach the hub. Local default below; in production set this
# to the domain served through Caddy, e.g. APP_URL=https://monitor.example.com
APP_URL=http://localhost:8090

# Agent pairing secrets. Empty = agent stays off.
# Create the system in the hub UI (Host / IP: /beszel_socket/beszel.sock),
# paste the generated values here, then re-run ./run.sh.
AGENT_TOKEN=
AGENT_KEY=