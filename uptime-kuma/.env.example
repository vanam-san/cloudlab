# Uptime Kuma deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.

# Uptime Kuma image (louislam/uptime-kuma:2)
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2

# Host port exposed for the web UI (localhost-only).
# 3002 because 3000 (umami) and 3001 (sure) are taken on this host.
# The container-internal port is always 3001.
UPTIME_KUMA_PORT=3002
