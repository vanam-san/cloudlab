# }

# Glance dashboard (localhost:8080)
# glance.example.com {
# 	reverse_proxy host.docker.internal:8080
# }

# Plane project management (localhost:8088)
# Headers below are required by Plane behind a proxy (per upstream docs:
# developers.plane.so/self-hosting/govern/reverse-proxy). Caddy handles
# the :80→:443 redirect and TLS automatically.
# plane.example.com {
# 	reverse_proxy host.docker.internal:8088 {
# 		header_up X-Forwarded-Proto {scheme}
# 		header_up X-Forwarded-Host {host}
# 		header_up X-Real-IP {remote_host}
# 		header_up X-Forwarded-For {remote_host}
# 		header_up Host {http.request.host}
# 	}
# }