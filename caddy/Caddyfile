# analytics.example.com {
# 	import tailscale-only
# 	reverse_proxy localhost:3000
# }

# Beszel monitoring (container beszel:8090) — Tailscale-only
# monitor.example.com {
# 	import tailscale-only
# 	reverse_proxy localhost:8090
# }

# Sure (container sure:3000 — internal port is always 3000,
# even though the host maps localhost:3001 for direct access) — Tailscale-only
# sure.example.com {
# 	import tailscale-only
# 	reverse_proxy localhost:3001
# }

# Glance dashboard (container glance:8080) — Tailscale-only
# glance.example.com {
# 	import tailscale-only
# 	reverse_proxy localhost:8080
# }

# Plane project management (container plane:80 — Plane's built-in proxy
# listens on :80 internally; localhost:9080 is only the host mapping)
# Headers below are required by Plane behind a proxy (per upstream docs:
# developers.plane.so/self-hosting/govern/reverse-proxy). Caddy handles
# the :80→:443 redirect and TLS automatically.
# plane.example.com {
# 	import tailscale-only
# 	reverse_proxy localhost:9080 {
# 		header_up X-Forwarded-Proto {scheme}
# 		header_up X-Forwarded-Host {host}
# 		header_up X-Real-IP {remote_host}
# 		header_up X-Forwarded-For {remote_host}
# 		header_up Host {http.request.host}
# 	}
# }

# Checkmk monitoring (container checkmk:5000 — the site web server
# listens on :5000 internally; localhost:8072 is only the host mapping.
# The /cmk/ site path works transparently behind the proxy) — Tailscale-only
# checkmk.domain.dev {
# 	import tailscale-only
# 	reverse_proxy localhost:8072
# }

# Uptime Kuma monitoring (container uptime-kuma:3001 — internal port is
# always 3001, even though the host maps localhost:3002 for direct
# access) — Tailscale-only
# uptime.domain {
# 	import tailscale-only
# 	reverse_proxy localhost:3002
# }

# Checkmate monitoring (container checkmate:52345 — upstream default port
# internally; the host maps localhost:8073 as 52345 can't bind here) — Tailscale-only. Set CLIENT_HOST to this
# domain in checkmate/.env for production (CORS + notification links).
# checkmate.example.com {
# 	import tailscale-only
# 	reverse_proxy localhost:8073
# }

# DEFAULT-DENY (active): anything not matching a site above — direct-IP
# probes, unknown SNI, scanners — gets its connection dropped instead of
# a 404. Per-site `import tailscale-only` enforces tailnet access on
# matched domains; this block covers everything else. Keep it last and
# always active, even with zero sites configured.
:80 {
	abort
}

:443 {
	abort
}