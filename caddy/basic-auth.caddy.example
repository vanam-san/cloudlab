# Template copy: cp basic-auth.caddy.example basic-auth.caddy — or simply
# run ./run.sh, which generates the live file with a strong random password
# (printed once). The live file is git-ignored — never commit it.
#
# This snippet is the DEFAULT gate for every site: the browser prompts for
# credentials before the request reaches the app (which still has its own
# login behind it). Add/remove users by editing the block below, then:
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
# Credentials are plain `username password` pairs — no hashing step.
# (Caddy accepts bcrypt hashes too if you ever prefer them at rest.)
(basic-auth) {
	@needs_auth {
		not path /.well-known/acme-challenge/*
	}
	basic_auth @needs_auth {
		__BASIC_AUTH_USER__ __BASIC_AUTH_PASSWORD__
		# anotheruser some-other-plain-password
	}
}
