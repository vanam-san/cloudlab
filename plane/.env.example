# Plane deployment config. Copy to .env and adjust (run.sh does this for you).
# Final file is git-ignored - never commit secrets.
# NOTE: Plane's own secrets live in plane-app/plane.env (managed by
# setup.sh, also git-ignored). This file only holds our local overrides.

# Host ports exposed for Plane's built-in proxy (localhost-only)
PLANE_PORT=8088
PLANE_HTTPS_PORT=9443

# Production: when serving through Caddy with HTTPS, set these to your
# domain so Plane generates correct links and accepts the origin.
# (run.sh writes them into plane-app/plane.env on every run.)
# PLANE_APP_DOMAIN=plane.example.com
# PLANE_WEB_URL=https://plane.example.com
# PLANE_CORS_ORIGINS=https://plane.example.com